msgid "T"
msgstr "T"

#. TRANSLATORS: symbol for "tera bytes" (best keep untranslated)
msgid "TB"
msgstr "TB"

#. TRANSLATORS: symbol for "tebi bytes" (best keep untranslated)
msgid "TiB"
msgstr "TiB"

#. TRANSLATORS: name of object
msgid "UDF"
msgstr "UDF"

#. TRANSLATORS: displayed before action,
#. %1$s is replaced by device name (e.g. /dev/sda1),
#. %2$s is replaced by size (e.g. 2GiB)
#, c-format
msgid "Unmount %1$s at %2$s"
msgstr "ຍົກເລີກການເມົາທ໌ %1$s ທີ່ %2$s"

#. TRANSLATORS:
#. %1$s is replaced with the nfs name (e.g. 99.99.00.00:path),
#. %2$s is replaced with the mount point (e.g. /home)
#, c-format
msgid "Unmount NFS %1$s at %2$s"
msgstr "ຍົກເລີກການເມົາທ໌ NFS %1$s ທີ່ %2$s"

#. TRANSLATORS:
#. %1$s is replaced with the names of the devices separated by comma (e.g. /dev/sda1, /dev/sda2),
#. %2$s is replaced with the mount point (e.g. /home)
#, c-format
msgid "Unmount file system btrfs on %1$s at %2$s"
msgstr "ຍົກເລີກການເມົາທ໌ລະບົບໄຟລ໌ btrfs ໃນ %1$s ທີ່ %2$s"

#. TRANSLATORS: displayed before action,
#. %1$s is replaced by subvolume path (e.g. home),
#. %2$s is replaced by device name (e.g. /dev/sda1),
#. %3$s is replaced by mount point (e.g. /home)
#, c-format
msgid "Unmount subvolume %1$s on %2$s at %3$s"
msgstr "ຍົກເລີກການເມົາທ໌ subvolume %1$s ໃນ %2$s ທີ່ %3$s"

#. TRANSLATORS: displayed during action,
#. %1$s is replaced by device name (e.g. /dev/sda1),
#. %2$s is replaced by size (e.g. 2GiB)
#, c-format
msgid "Unmounting %1$s at %2$s"
msgstr "ກຳລັງຍົກເລີກການເມົາທ໌ %1$s ທີ່ %2$s"

#. TRANSLATORS: displayed during action,
#. %1$s is replaced by subvolume path (e.g. home),
#. %2$s is replaced by device name (e.g. /dev/sda1),
#. %3$s is replaced by mount point (e.g. /home)
#, c-format
msgid "Unmounting subvolume %1$s on %2$s at %3$s"
msgstr "ກຳລັງຍົກເລີກການເມົາທ໌ subvolume %1$s ໃນ %2$s ທີ່ %3$s"

#. TRANSLATORS: displayed before action,
#. %1$s is replaced by mount point (e.g. /home),
#. %2$s is replaced by device name (e.g. /dev/sda1)
#, c-format
msgid "Update mount point %1$s of %2$s in /etc/fstab"
msgstr "ອັບເດດຈຸດເມົາທ໌ %1$s ຂອງ %2$s ໃນ /etc/fstab"

#. TRANSLATORS: displayed during action,
#. %1$s is replaced by mount point (e.g. /home),
#. %2$s is replaced by device name (e.g. /dev/sda1)
#, c-format
msgid "Updating mount point %1$s of %2$s in /etc/fstab"
msgstr "ກຳລັງອັບເດດຈຸດເມົາທ໌ %1$s ຂອງ %2$s ໃນ /etc/fstab"

